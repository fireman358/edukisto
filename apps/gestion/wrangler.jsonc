{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestion",
  "compatibility_date": "2026-11-12",
  "main": "worker.js",
  "assets": {
    "directory": "./public"
  },
  // Route du sous-domaine, si le token Cloudflare a les droits sur la zone edukisto.win.
  // Sinon : custom domain ajoutée dans le dashboard (Workers & Pages > gestion > Domains & Routes).
  // "routes": [{ "pattern": "gestion.edukisto.win/*", "zone_name": "edukisto.win" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestion",
      // Créer la base puis coller l'id ici : npx wrangler d1 create gestion
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
