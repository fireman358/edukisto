{
  // Worker Barakfix : API /api/* + assets statiques (build Vite dans ./dist)
  "name": "barakfix",
  "compatibility_date": "2026-11-12",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barakfix",
      "database_id": "b4d7513d-920d-4d71-803b-70a837487640"
    }
  ]
}
